      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CorregirDatos_di" bpmnElement="CorregirDatos">
        <omgdc:Bounds x="1330" y="315" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MergeCaja_di" bpmnElement="MergeCaja" isMarkerVisible="true">
        <omgdc:Bounds x="635" y="460" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="594" y="518" width="132" height="28" />
