        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwCuadraCaja_di" bpmnElement="GwCuadraCaja" isMarkerVisible="true">
        <omgdc:Bounds x="995" y="460" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="970.2" y="438" width="99.6" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InformarDif_di" bpmnElement="InformarDif">
        <omgdc:Bounds x="1150" y="445" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="VistoBuenoCaja_di" bpmnElement="VistoBuenoCaja">
        <omgdc:Bounds x="1150" y="575" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndCajaValidada_di" bpmnElement="EndCajaValidada">
        <omgdc:Bounds x="1362" y="597" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1314" y="641" width="132" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_InformeCaja_di" bpmnElement="Data_InformeCaja">
        <omgdc:Bounds x="462" y="330" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="414" y="386" width="132" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f01_di" bpmnElement="f01">
        <omgdi:waypoint x="318" y="225" />
        <omgdi:waypoint x="430" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f02_di" bpmnElement="f02">
