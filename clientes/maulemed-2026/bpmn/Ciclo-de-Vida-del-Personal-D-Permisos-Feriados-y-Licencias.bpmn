<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PER_v5_D" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_PER_D">
    <participant id="P_D" name="Permisos, feriados y licencias médicas — MauleMed" processRef="Process_PER_D" />
    <participant id="P_INST" name="Isapres, Fonasa y caja de compensación" />
    <messageFlow id="m01" name="Licencia a tramitar" sourceRef="TramitarLicencia" targetRef="P_INST" />
  </collaboration>
  <process id="Process_PER_D" isExecutable="false">
    <laneSet id="LaneSet_PER_D">
      <lane id="Lane_Pat" name="Patricia Lobos — Encargada de Personas y RR.HH.">
        <flowNodeRef>StartPermiso</flowNodeRef>
        <flowNodeRef>CoordinarCobertura</flowNodeRef>
        <flowNodeRef>GwFeriado</flowNodeRef>
        <flowNodeRef>VerificarSaldo</flowNodeRef>
        <flowNodeRef>AutorizarFeriado</flowNodeRef>
        <flowNodeRef>EndFeriado</flowNodeRef>
        <flowNodeRef>AutorizarPermiso</flowNodeRef>
        <flowNodeRef>EndPermiso</flowNodeRef>
        <flowNodeRef>StartRevision</flowNodeRef>
        <flowNodeRef>RevisarPlataformas</flowNodeRef>
        <flowNodeRef>GwLicFalta</flowNodeRef>
        <flowNodeRef>ContactarTrabajador</flowNodeRef>
        <flowNodeRef>EndEspera</flowNodeRef>
        <flowNodeRef>EndSinPendientes</flowNodeRef>
        <flowNodeRef>StartLicencia</flowNodeRef>
        <flowNodeRef>TramitarLicencia</flowNodeRef>
        <flowNodeRef>RegistrarLicencia</flowNodeRef>
        <flowNodeRef>EndLicencia</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartPermiso" name="Solicitud de permiso o feriado legal">
      <outgoing>f01</outgoing>
      <messageEventDefinition id="MessageEventDefinition_StartPermiso" />
    </startEvent>
    <userTask id="CoordinarCobertura" name="Coordinar la cobertura del turno">
      <incoming>f01</incoming>
      <outgoing>f02</outgoing>
    </userTask>
    <exclusiveGateway id="GwFeriado" name="¿Es feriado legal?">
      <incoming>f02</incoming>
      <outgoing>f03</outgoing>
      <outgoing>f04</outgoing>
    </exclusiveGateway>
    <manualTask id="VerificarSaldo" name="Verificar el saldo de feriado y los días progresivos">
      <incoming>f03</incoming>
      <outgoing>f05</outgoing>
    </manualTask>
    <userTask id="AutorizarFeriado" name="Autorizar y registrar el feriado">
      <incoming>f05</incoming>
      <outgoing>f06</outgoing>
    </userTask>
    <endEvent id="EndFeriado" name="Feriado autorizado y registrado">
      <incoming>f06</incoming>
    </endEvent>
    <userTask id="AutorizarPermiso" name="Autorizar y registrar el permiso">
      <incoming>f04</incoming>
      <outgoing>f07</outgoing>
    </userTask>
    <endEvent id="EndPermiso" name="Permiso autorizado y registrado">
      <incoming>f07</incoming>
    </endEvent>
    <startEvent id="StartRevision" name="Tres veces por semana (revisión de licencias)">
      <outgoing>f08</outgoing>
      <timerEventDefinition id="TimerEventDefinition_StartRevision" />
    </startEvent>
    <userTask id="RevisarPlataformas" name="Revisar las licencias en las plataformas del empleador">
      <incoming>f08</incoming>
      <outgoing>f09</outgoing>
    </userTask>
    <exclusiveGateway id="GwLicFalta" name="¿Falta alguna licencia?">
      <incoming>f09</incoming>
      <outgoing>f10</outgoing>
      <outgoing>f11</outgoing>
    </exclusiveGateway>
    <sendTask id="ContactarTrabajador" name="Contactar al trabajador">
      <incoming>f10</incoming>
      <outgoing>f12</outgoing>
    </sendTask>
    <endEvent id="EndEspera" name="Queda a la espera de la próxima revisión">
      <incoming>f12</incoming>
    </endEvent>
    <endEvent id="EndSinPendientes" name="Sin licencias pendientes">
      <incoming>f11</incoming>
    </endEvent>
    <startEvent id="StartLicencia" name="Recepción de una licencia médica">
      <outgoing>f13</outgoing>
      <messageEventDefinition id="MessageEventDefinition_StartLicencia" />
    </startEvent>
    <sendTask id="TramitarLicencia" name="Tramitar la licencia ante la caja, la isapre o Fonasa">
      <incoming>f13</incoming>
      <outgoing>f14</outgoing>
    </sendTask>
    <userTask id="RegistrarLicencia" name="Registrar la licencia en el control de asistencia">
      <incoming>f14</incoming>
      <outgoing>f15</outgoing>
    </userTask>
    <endEvent id="EndLicencia" name="Licencia tramitada y registrada">
      <incoming>f15</incoming>
    </endEvent>
    <sequenceFlow id="f01" sourceRef="StartPermiso" targetRef="CoordinarCobertura" />
    <sequenceFlow id="f02" sourceRef="CoordinarCobertura" targetRef="GwFeriado" />
    <sequenceFlow id="f03" name="SÍ" sourceRef="GwFeriado" targetRef="VerificarSaldo" />
    <sequenceFlow id="f04" name="NO" sourceRef="GwFeriado" targetRef="AutorizarPermiso" />
    <sequenceFlow id="f05" sourceRef="VerificarSaldo" targetRef="AutorizarFeriado" />
    <sequenceFlow id="f06" sourceRef="AutorizarFeriado" targetRef="EndFeriado" />
    <sequenceFlow id="f07" sourceRef="AutorizarPermiso" targetRef="EndPermiso" />
    <sequenceFlow id="f08" sourceRef="StartRevision" targetRef="RevisarPlataformas" />
    <sequenceFlow id="f09" sourceRef="RevisarPlataformas" targetRef="GwLicFalta" />
    <sequenceFlow id="f10" name="SÍ" sourceRef="GwLicFalta" targetRef="ContactarTrabajador" />
    <sequenceFlow id="f11" name="NO" sourceRef="GwLicFalta" targetRef="EndSinPendientes" />
    <sequenceFlow id="f12" sourceRef="ContactarTrabajador" targetRef="EndEspera" />
    <sequenceFlow id="f13" sourceRef="StartLicencia" targetRef="TramitarLicencia" />
    <sequenceFlow id="f14" sourceRef="TramitarLicencia" targetRef="RegistrarLicencia" />
    <sequenceFlow id="f15" sourceRef="RegistrarLicencia" targetRef="EndLicencia" />
  </process>
