  <collaboration id="Collaboration_0ula7yg">
    <participant id="Participant_0cmiqer" name="MauleMed" processRef="Process_1" />
    <participant id="Participant_1rm6v6o" name="Paciente/ Otros" processRef="Process_17yy1al" />
    <messageFlow id="Flow_1r27y6e" sourceRef="Activity_18of1lw" targetRef="Participant_1rm6v6o" />
    <messageFlow id="Flow_0cpx9e7" sourceRef="Participant_1rm6v6o" targetRef="Event_0ey2999" />
    <textAnnotation id="TextAnnotation_0s2zm7j">
      <text>Canales actuales: formulario físico, página web, correo electrónico, WhatsApp y atención presencial.</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_1uj4xce">
      <text>Calidad insiste para obtener retroalimentación</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0a2v2uo">
      <text>RR.HH. se informa cuando la situación requiere apoyo en medidas correctivas, capacitación, retroalimentación al personal o seguimiento de compromisos</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_1qmctkl">
      <text>La respuesta debe enviarse dentro del plazo máximo de 15 días hábiles desde que se recibió el reclamo.</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0zcdz2c">
      <text>El expediente se archiva física y digitalmente e incluye el reclamo, folio, antecedentes, retroalimentación del área y respuesta enviada.</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0ay2dcx">
      <text>Análisis trimestral se entrega a Dirección, Gerencia y Comité de Calidad, y que contiene número total de reclamos, tipificación, distribución por área, causas, cumplimiento del plazo, tendencias, acciones correctivas e indicadores</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_1jr7u2j">
      <text>Se espera tener la retroalimentación del área dentro de un plazo de 48 hrs.</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_1a9svc7">
      <text>El paciente dispone de 5 días hábiles para manifestar disconformidad con la respuesta.</text>
    </textAnnotation>
    <association id="Association_0q2cdcl" associationDirection="None" sourceRef="Activity_051oczc" targetRef="TextAnnotation_1uj4xce" />
    <textAnnotation id="TextAnnotation_1jzfjsd">
      <text>Correo electrónico</text>
    </textAnnotation>
    <association id="Association_13bvlzm" associationDirection="None" sourceRef="Activity_1ttyac2" targetRef="TextAnnotation_1jzfjsd" />
    <association id="Association_0d1m0dj" associationDirection="None" sourceRef="Gateway_0px5i6p" targetRef="TextAnnotation_0a2v2uo" />
    <association id="Association_1ky7jrt" associationDirection="None" sourceRef="Activity_18of1lw" targetRef="TextAnnotation_1qmctkl" />
    <association id="Association_1dj4f1u" associationDirection="None" sourceRef="Activity_1gfu8po" targetRef="TextAnnotation_1jr7u2j" />
    <association id="Association_1y3dam3" associationDirection="None" sourceRef="Activity_0wd2m0c" targetRef="TextAnnotation_0zcdz2c" />
    <textAnnotation id="TextAnnotation_04mxpmz">
      <text>El incumplimiento se incorpora al indicador trimestral.</text>
    </textAnnotation>
