<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PER_v5_A" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_PER_A">
    <participant id="P_A" name="Reclutamiento y selección de personal — MauleMed" processRef="Process_PER_A" />
    <participant id="P_TRAB" name="Postulantes" />
    <messageFlow id="m01" name="Oferta de trabajo" sourceRef="PublicarOferta" targetRef="P_TRAB" />
    <messageFlow id="m02" name="Postulación y currículum" sourceRef="P_TRAB" targetRef="RecepPost" />
  </collaboration>
  <process id="Process_PER_A" isExecutable="false">
    <laneSet id="LaneSet_PER_A">
      <lane id="Lane_Med" name="Dirección médica — Dr. Retamal y Dr. Valenzuela">
        <flowNodeRef>EntrevistaMed</flowNodeRef>
      </lane>
      <lane id="Lane_Pat" name="Patricia Lobos — Encargada de Personas y RR.HH.">
        <flowNodeRef>StartVacante</flowNodeRef>
        <flowNodeRef>DefinirPerfil</flowNodeRef>
        <flowNodeRef>PublicarOferta</flowNodeRef>
        <flowNodeRef>RecepPost</flowNodeRef>
        <flowNodeRef>FiltrarCV</flowNodeRef>
        <flowNodeRef>Entrevista</flowNodeRef>
        <flowNodeRef>GwPerfil</flowNodeRef>
        <flowNodeRef>EndReabrir1</flowNodeRef>
        <flowNodeRef>Terna</flowNodeRef>
        <flowNodeRef>EvalPsico</flowNodeRef>
        <flowNodeRef>GwTipo</flowNodeRef>
        <flowNodeRef>MergeDest</flowNodeRef>
        <flowNodeRef>DecidirConjunto</flowNodeRef>
        <flowNodeRef>GwSeleccion</flowNodeRef>
        <flowNodeRef>EndReabrir2</flowNodeRef>
        <flowNodeRef>NotificarSel</flowNodeRef>
        <flowNodeRef>EndSeleccionado</flowNodeRef>
      </lane>
      <lane id="Lane_Liz" name="Liz Bravo — Jefa de Administración y Finanzas">
        <flowNodeRef>EntrevistaLiz</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartVacante" name="Surge la necesidad de contratación">
      <outgoing>f01</outgoing>
    </startEvent>
    <userTask id="DefinirPerfil" name="Definir el perfil del cargo y aprobar la vacante">
      <incoming>f01</incoming>
      <outgoing>f02</outgoing>
    </userTask>
    <sendTask id="PublicarOferta" name="Publicar y difundir la oferta de trabajo">
      <incoming>f02</incoming>
      <outgoing>f03</outgoing>
    </sendTask>
    <intermediateCatchEvent id="RecepPost" name="Recepción de postulaciones">
      <incoming>f03</incoming>
      <outgoing>f04</outgoing>
      <messageEventDefinition id="MessageEventDefinition_RecepPost" />
    </intermediateCatchEvent>
    <manualTask id="FiltrarCV" name="Revisar los currículums y filtrar por perfil">
      <incoming>f04</incoming>
      <outgoing>f05</outgoing>
      <dataOutputAssociation id="DataOut_CV">
        <targetRef>Data_CV</targetRef>
      </dataOutputAssociation>
    </manualTask>
    <userTask id="Entrevista" name="Citar y realizar la entrevista de preselección">
      <incoming>f05</incoming>
      <outgoing>f06</outgoing>
    </userTask>
    <exclusiveGateway id="GwPerfil" name="¿Hay candidatos que cumplan el perfil?">
      <incoming>f06</incoming>
      <outgoing>f07</outgoing>
      <outgoing>f08</outgoing>
    </exclusiveGateway>
    <endEvent id="EndReabrir1" name="Se reabre la convocatoria">
      <incoming>f07</incoming>
    </endEvent>
    <userTask id="Terna" name="Conformar la terna de finalistas">
      <incoming>f08</incoming>
      <outgoing>f09</outgoing>
    </userTask>
    <userTask id="EvalPsico" name="Aplicar la evaluación psicolaboral cuando se requiere">
      <incoming>f09</incoming>
      <outgoing>f10</outgoing>
    </userTask>
    <exclusiveGateway id="GwTipo" name="¿El cargo es clínico o administrativo?">
      <incoming>f10</incoming>
      <outgoing>f11</outgoing>
      <outgoing>f12</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="MergeDest" name="Entrevista final realizada">
      <incoming>f13</incoming>
      <incoming>f14</incoming>
      <outgoing>f15</outgoing>
    </exclusiveGateway>
    <userTask id="DecidirConjunto" name="Acordar la decisión final entre ambas partes">
      <incoming>f15</incoming>
      <outgoing>f16</outgoing>
    </userTask>
    <exclusiveGateway id="GwSeleccion" name="¿Se selecciona a un candidato?">
      <incoming>f16</incoming>
      <outgoing>f17</outgoing>
      <outgoing>f18</outgoing>
    </exclusiveGateway>
    <endEvent id="EndReabrir2" name="Se reabre la convocatoria">
      <incoming>f17</incoming>
    </endEvent>
    <sendTask id="NotificarSel" name="Notificar la selección y citar para la contratación">
      <incoming>f18</incoming>
      <outgoing>f19</outgoing>
    </sendTask>
    <endEvent id="EndSeleccionado" name="Candidato seleccionado">
      <incoming>f19</incoming>
    </endEvent>
    <userTask id="EntrevistaMed" name="Realizar la entrevista final al candidato clínico">
      <incoming>f11</incoming>
      <outgoing>f13</outgoing>
    </userTask>
    <userTask id="EntrevistaLiz" name="Realizar la entrevista final al candidato administrativo">
      <incoming>f12</incoming>
      <outgoing>f14</outgoing>
    </userTask>
    <dataObjectReference id="Data_CV" name="Currículums recibidos · correo" dataObjectRef="DataObject_CV" />
    <dataObject id="DataObject_CV" />
    <sequenceFlow id="f01" sourceRef="StartVacante" targetRef="DefinirPerfil" />
    <sequenceFlow id="f02" sourceRef="DefinirPerfil" targetRef="PublicarOferta" />
    <sequenceFlow id="f03" sourceRef="PublicarOferta" targetRef="RecepPost" />
    <sequenceFlow id="f04" sourceRef="RecepPost" targetRef="FiltrarCV" />
    <sequenceFlow id="f05" sourceRef="FiltrarCV" targetRef="Entrevista" />
    <sequenceFlow id="f06" sourceRef="Entrevista" targetRef="GwPerfil" />
    <sequenceFlow id="f07" name="NO" sourceRef="GwPerfil" targetRef="EndReabrir1" />
    <sequenceFlow id="f08" name="SÍ" sourceRef="GwPerfil" targetRef="Terna" />
    <sequenceFlow id="f09" sourceRef="Terna" targetRef="EvalPsico" />
    <sequenceFlow id="f10" sourceRef="EvalPsico" targetRef="GwTipo" />
    <sequenceFlow id="f11" name="Clínico" sourceRef="GwTipo" targetRef="EntrevistaMed" />
    <sequenceFlow id="f12" name="Administrativo" sourceRef="GwTipo" targetRef="EntrevistaLiz" />
    <sequenceFlow id="f13" sourceRef="EntrevistaMed" targetRef="MergeDest" />
    <sequenceFlow id="f14" sourceRef="EntrevistaLiz" targetRef="MergeDest" />
    <sequenceFlow id="f15" sourceRef="MergeDest" targetRef="DecidirConjunto" />
    <sequenceFlow id="f16" sourceRef="DecidirConjunto" targetRef="GwSeleccion" />
    <sequenceFlow id="f17" name="NO" sourceRef="GwSeleccion" targetRef="EndReabrir2" />
    <sequenceFlow id="f18" name="SÍ" sourceRef="GwSeleccion" targetRef="NotificarSel" />
    <sequenceFlow id="f19" sourceRef="NotificarSel" targetRef="EndSeleccionado" />
  </process>
