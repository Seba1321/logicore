<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PER_v5_B" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_PER_B">
    <participant id="P_B" name="Contratación e incorporación de personal — MauleMed" processRef="Process_PER_B" />
    <participant id="P_TRAB" name="Trabajador" />
    <messageFlow id="m01" name="Contrato y anexos para firma" sourceRef="FirmaTrab" targetRef="P_TRAB" />
  </collaboration>
  <process id="Process_PER_B" isExecutable="false">
    <laneSet id="LaneSet_PER_B">
      <lane id="Lane_Med" name="Dirección médica — representante legal">
        <flowNodeRef>FirmaRepLegal</flowNodeRef>
      </lane>
      <lane id="Lane_Pat" name="Patricia Lobos — Encargada de Personas y RR.HH.">
        <flowNodeRef>StartSel</flowNodeRef>
        <flowNodeRef>RecopilarDocs</flowNodeRef>
        <flowNodeRef>DefSociedad</flowNodeRef>
        <flowNodeRef>EnviarFicha</flowNodeRef>
        <flowNodeRef>GenContrato</flowNodeRef>
        <flowNodeRef>RegDeFontana</flowNodeRef>
        <flowNodeRef>AnexoHHEE</flowNodeRef>
        <flowNodeRef>OtrosAnexos</flowNodeRef>
        <flowNodeRef>DAS</flowNodeRef>
        <flowNodeRef>Reglamento</flowNodeRef>
        <flowNodeRef>FirmaTrab</flowNodeRef>
        <flowNodeRef>AFP</flowNodeRef>
        <flowNodeRef>AFC</flowNodeRef>
        <flowNodeRef>Mutual</flowNodeRef>
        <flowNodeRef>Caja</flowNodeRef>
        <flowNodeRef>ConfirmarPrevired</flowNodeRef>
        <flowNodeRef>RelojControl</flowNodeRef>
        <flowNodeRef>Tutor</flowNodeRef>
        <flowNodeRef>EndOnboarding</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartSel" name="Candidato seleccionado para el cargo">
      <outgoing>f01</outgoing>
    </startEvent>
    <userTask id="RecopilarDocs" name="Recopilar la documentación y completar la ficha de ingreso">
      <incoming>f01</incoming>
      <outgoing>f02</outgoing>
      <dataOutputAssociation id="DataOut_Ficha">
        <targetRef>Data_Ficha</targetRef>
      </dataOutputAssociation>
    </userTask>
    <userTask id="DefSociedad" name="Determinar la sociedad empleadora y la sucursal">
      <incoming>f02</incoming>
      <outgoing>f03</outgoing>
    </userTask>
    <sendTask id="EnviarFicha" name="Enviar la ficha de ingreso al control de gestión">
      <incoming>f03</incoming>
      <outgoing>f04</outgoing>
    </sendTask>
    <userTask id="GenContrato" name="Seleccionar el contrato tipo y generarlo">
      <incoming>f04</incoming>
      <outgoing>f05</outgoing>
      <dataOutputAssociation id="DataOut_Contrato">
        <targetRef>Data_Contrato</targetRef>
      </dataOutputAssociation>
    </userTask>
    <userTask id="RegDeFontana" name="Registrar el contrato en DeFontana y en la Dirección del Trabajo">
      <incoming>f05</incoming>
      <outgoing>f06</outgoing>
    </userTask>
    <userTask id="AnexoHHEE" name="Generar el anexo de pacto de horas extraordinarias">
      <incoming>f06</incoming>
      <outgoing>f07</outgoing>
    </userTask>
    <userTask id="OtrosAnexos" name="Generar los anexos adicionales que correspondan">
      <incoming>f07</incoming>
      <outgoing>f08</outgoing>
    </userTask>
    <userTask id="DAS" name="Emitir la obligación de informar los riesgos laborales">
      <incoming>f08</incoming>
      <outgoing>f09</outgoing>
    </userTask>
    <userTask id="Reglamento" name="Entregar el Reglamento Interno">
      <incoming>f09</incoming>
      <outgoing>f10</outgoing>
    </userTask>
    <userTask id="FirmaTrab" name="Recabar la firma del trabajador">
      <incoming>f10</incoming>
      <outgoing>f11</outgoing>
      <dataOutputAssociation id="DataOut_Expediente">
        <targetRef>Data_Expediente</targetRef>
      </dataOutputAssociation>
    </userTask>
    <manualTask id="FirmaRepLegal" name="Firmar el contrato como representante legal">
      <incoming>f11</incoming>
      <outgoing>fw12</outgoing>
    </manualTask>
    <userTask id="AFP" name="Afiliar en AFP y en salud (Fonasa o isapre)">
      <incoming>fw12</incoming>
      <outgoing>f13</outgoing>
    </userTask>
    <userTask id="AFC" name="Inscribir en el seguro de cesantía">
      <incoming>f13</incoming>
      <outgoing>f14</outgoing>
    </userTask>
    <userTask id="Mutual" name="Afiliar a la mutualidad">
      <incoming>f14</incoming>
      <outgoing>f15</outgoing>
    </userTask>
    <userTask id="Caja" name="Incorporar a la caja de compensación">
      <incoming>f15</incoming>
      <outgoing>f16</outgoing>
    </userTask>
    <userTask id="ConfirmarPrevired" name="Confirmar las altas previsionales en Previred">
      <incoming>f16</incoming>
      <outgoing>f17</outgoing>
    </userTask>
    <userTask id="RelojControl" name="Ingresar al control de asistencia y asignar el turno">
      <incoming>f17</incoming>
      <outgoing>f18</outgoing>
    </userTask>
    <userTask id="Tutor" name="Asignar una tutora de inducción por dos semanas">
      <incoming>f18</incoming>
      <outgoing>f19</outgoing>
    </userTask>
    <endEvent id="EndOnboarding" name="Trabajador incorporado">
      <incoming>f19</incoming>
    </endEvent>
    <dataObjectReference id="Data_Ficha" name="Ficha de ingreso · Word" dataObjectRef="DataObject_Ficha" />
    <dataObject id="DataObject_Ficha" />
    <dataObjectReference id="Data_Contrato" name="Contrato y anexos · Word" dataObjectRef="DataObject_Contrato" />
    <dataObject id="DataObject_Contrato" />
    <dataObjectReference id="Data_Expediente" name="Expediente del trabajador · carpeta de la sociedad" dataObjectRef="DataObject_Expediente" />
    <dataObject id="DataObject_Expediente" />
    <sequenceFlow id="f01" sourceRef="StartSel" targetRef="RecopilarDocs" />
    <sequenceFlow id="f02" sourceRef="RecopilarDocs" targetRef="DefSociedad" />
    <sequenceFlow id="f03" sourceRef="DefSociedad" targetRef="EnviarFicha" />
    <sequenceFlow id="f04" sourceRef="EnviarFicha" targetRef="GenContrato" />
    <sequenceFlow id="f05" sourceRef="GenContrato" targetRef="RegDeFontana" />
    <sequenceFlow id="f06" sourceRef="RegDeFontana" targetRef="AnexoHHEE" />
    <sequenceFlow id="f07" sourceRef="AnexoHHEE" targetRef="OtrosAnexos" />
    <sequenceFlow id="f08" sourceRef="OtrosAnexos" targetRef="DAS" />
    <sequenceFlow id="f09" sourceRef="DAS" targetRef="Reglamento" />
    <sequenceFlow id="f10" sourceRef="Reglamento" targetRef="FirmaTrab" />
    <sequenceFlow id="f11" sourceRef="FirmaTrab" targetRef="FirmaRepLegal" />
    <sequenceFlow id="fw12" sourceRef="FirmaRepLegal" targetRef="AFP" />
    <sequenceFlow id="f13" sourceRef="AFP" targetRef="AFC" />
    <sequenceFlow id="f14" sourceRef="AFC" targetRef="Mutual" />
    <sequenceFlow id="f15" sourceRef="Mutual" targetRef="Caja" />
    <sequenceFlow id="f16" sourceRef="Caja" targetRef="ConfirmarPrevired" />
    <sequenceFlow id="f17" sourceRef="ConfirmarPrevired" targetRef="RelojControl" />
    <sequenceFlow id="f18" sourceRef="RelojControl" targetRef="Tutor" />
    <sequenceFlow id="f19" sourceRef="Tutor" targetRef="EndOnboarding" />
  </process>
