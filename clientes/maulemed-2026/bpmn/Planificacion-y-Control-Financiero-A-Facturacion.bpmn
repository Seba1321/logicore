<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PCF_v5_A" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_PCF_A">
    <participant id="P_A" name="Facturación a instituciones — MauleMed" processRef="Process_PCF_A" />
    <participant id="P_CAJA" name="Cierre y cuadratura de caja (proceso D)" />
    <participant id="P_INST" name="FONASA, isapres e instituciones" />
    <messageFlow id="m01" sourceRef="P_CAJA" targetRef="StartFact" />
    <messageFlow id="m02" sourceRef="EmitirDocumento" targetRef="P_INST" />
  </collaboration>
  <process id="Process_PCF_A" isExecutable="false">
    <laneSet id="LaneSet_PCF_A">
      <lane id="Lane_Liz" name="Liz Bravo — Jefa de Administración y Finanzas">
        <flowNodeRef>RevisarCobranza</flowNodeRef>
        <flowNodeRef>GwCompleto</flowNodeRef>
        <flowNodeRef>InstruirRegular</flowNodeRef>
      </lane>
      <lane id="Lane_Gab" name="Gabriela Morales — Tesorería y Facturación">
        <flowNodeRef>StartFact</flowNodeRef>
        <flowNodeRef>GwCanal</flowNodeRef>
        <flowNodeRef>ExtraerNomina</flowNodeRef>
        <flowNodeRef>ReunirBonos</flowNodeRef>
        <flowNodeRef>CompararBonos</flowNodeRef>
        <flowNodeRef>GwCuadra</flowNodeRef>
        <flowNodeRef>VerificarDif</flowNodeRef>
        <flowNodeRef>MergeCuadra</flowNodeRef>
        <flowNodeRef>MergeCanal</flowNodeRef>
        <flowNodeRef>DeterminarRS</flowNodeRef>
        <flowNodeRef>EmitirDocumento</flowNodeRef>
        <flowNodeRef>EndFacturado</flowNodeRef>
        <flowNodeRef>EndPendiente</flowNodeRef>
      </lane>
      <lane id="Lane_Con" name="Contabilidad — Elvira Rojas y Meribet Escobar">
        <flowNodeRef>RegistrarContab</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartFact" name="Caja validada y cobranza pendiente">
      <outgoing>f01</outgoing>
      <messageEventDefinition id="MessageEventDefinition_StartFact" />
    </startEvent>
    <exclusiveGateway id="GwCanal" name="¿El cobro de esta prestación va por nómina FONASA o por bono u orden?">
      <incoming>f01</incoming>
      <outgoing>f02</outgoing>
      <outgoing>f03</outgoing>
    </exclusiveGateway>
    <userTask id="ExtraerNomina" name="Extraer del RISPACS la nómina de cobranza FONASA">
      <incoming>f02</incoming>
      <outgoing>f10</outgoing>
    </userTask>
    <manualTask id="ReunirBonos" name="Reunir los bonos y órdenes manuales de isapres e instituciones">
      <incoming>f03</incoming>
      <outgoing>f04</outgoing>
      <dataOutputAssociation id="DataOut_Bonos">
        <targetRef>Data_Bonos</targetRef>
      </dataOutputAssociation>
    </manualTask>
    <manualTask id="CompararBonos" name="Comparar los bonos y órdenes contra el registro del RISPACS">
      <incoming>f04</incoming>
      <outgoing>f05</outgoing>
    </manualTask>
    <exclusiveGateway id="GwCuadra" name="¿Cuadra la comparativa?">
      <incoming>f05</incoming>
      <outgoing>f06</outgoing>
      <outgoing>f07</outgoing>
    </exclusiveGateway>
    <manualTask id="VerificarDif" name="Verificar y corroborar las diferencias">
      <incoming>f06</incoming>
      <outgoing>f08</outgoing>
    </manualTask>
    <exclusiveGateway id="MergeCuadra" name="Comparativa resuelta">
      <incoming>f07</incoming>
      <incoming>f08</incoming>
      <outgoing>f09</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="MergeCanal" name="Respaldo del cobro preparado">
      <incoming>f09</incoming>
      <incoming>f10</incoming>
      <outgoing>f11</outgoing>
    </exclusiveGateway>
    <userTask id="DeterminarRS" name="Determinar la razón social y la resolución que corresponden">
      <incoming>f11</incoming>
      <outgoing>f12</outgoing>
    </userTask>
    <userTask id="EmitirDocumento" name="Emitir el documento tributario">
      <incoming>f12</incoming>
      <outgoing>f13</outgoing>
    </userTask>
    <endEvent id="EndFacturado" name="Facturación emitida y registrada">
      <incoming>f17</incoming>
    </endEvent>
    <userTask id="RegistrarContab" name="Registrar la facturación y la cobranza en contabilidad">
      <incoming>f13</incoming>
      <outgoing>f14</outgoing>
    </userTask>
    <userTask id="RevisarCobranza" name="Revisar en el RISPACS que esté facturado y cobrado">
      <incoming>f14</incoming>
      <outgoing>f15</outgoing>
    </userTask>
    <exclusiveGateway id="GwCompleto" name="¿Está todo facturado y cobrado?">
      <incoming>f15</incoming>
      <outgoing>f16</outgoing>
      <outgoing>f17</outgoing>
    </exclusiveGateway>
    <sendTask id="InstruirRegular" name="Instruir la regularización a tesorería">
      <incoming>f16</incoming>
      <outgoing>f18</outgoing>
    </sendTask>
    <endEvent id="EndPendiente" name="Queda pendiente para la próxima revisión">
      <incoming>f18</incoming>
    </endEvent>
    <dataObjectReference id="Data_Bonos" name="Bonos y órdenes de isapres e instituciones" dataObjectRef="DataObject_Bonos" />
    <dataObject id="DataObject_Bonos" />
    <sequenceFlow id="f01" sourceRef="StartFact" targetRef="GwCanal" />
    <sequenceFlow id="f02" name="Nómina FONASA" sourceRef="GwCanal" targetRef="ExtraerNomina" />
    <sequenceFlow id="f03" name="Bono u orden" sourceRef="GwCanal" targetRef="ReunirBonos" />
    <sequenceFlow id="f04" sourceRef="ReunirBonos" targetRef="CompararBonos" />
    <sequenceFlow id="f05" sourceRef="CompararBonos" targetRef="GwCuadra" />
    <sequenceFlow id="f06" name="NO" sourceRef="GwCuadra" targetRef="VerificarDif" />
    <sequenceFlow id="f07" name="SÍ" sourceRef="GwCuadra" targetRef="MergeCuadra" />
    <sequenceFlow id="f08" sourceRef="VerificarDif" targetRef="MergeCuadra" />
    <sequenceFlow id="f09" sourceRef="MergeCuadra" targetRef="MergeCanal" />
    <sequenceFlow id="f10" sourceRef="ExtraerNomina" targetRef="MergeCanal" />
    <sequenceFlow id="f11" sourceRef="MergeCanal" targetRef="DeterminarRS" />
    <sequenceFlow id="f12" sourceRef="DeterminarRS" targetRef="EmitirDocumento" />
    <sequenceFlow id="f13" sourceRef="EmitirDocumento" targetRef="RegistrarContab" />
    <sequenceFlow id="f14" sourceRef="RegistrarContab" targetRef="RevisarCobranza" />
    <sequenceFlow id="f15" sourceRef="RevisarCobranza" targetRef="GwCompleto" />
    <sequenceFlow id="f16" name="NO" sourceRef="GwCompleto" targetRef="InstruirRegular" />
    <sequenceFlow id="f17" name="SÍ" sourceRef="GwCompleto" targetRef="EndFacturado" />
    <sequenceFlow id="f18" sourceRef="InstruirRegular" targetRef="EndPendiente" />
  </process>
