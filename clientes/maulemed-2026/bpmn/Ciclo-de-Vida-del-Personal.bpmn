    <bpmn:messageFlow id="m9" sourceRef="P_CAND" targetRef="StartLicencia" />
    <bpmn:messageFlow id="m10" sourceRef="P_APROB" targetRef="StartTermino" />
    <bpmn:messageFlow id="m11" sourceRef="FirmasFiniq" targetRef="P_APROB" />
    <bpmn:messageFlow id="m12" sourceRef="Ratificar" targetRef="P_INST" />
    <bpmn:messageFlow id="m13" sourceRef="PagoFiniq" targetRef="P_CAND" />
    <bpmn:textAnnotation id="An1">
      <bpmn:text>Fuentes de reclutamiento: Bolsa Nacional de Empleo, red de contactos (difusion masiva) y referidos de la zona.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="An3">
      <bpmn:text>DOLOR: revision manual marcaje por marcaje (~1 a 1,5 dias/mes). OPORTUNIDAD: validacion automatica de marcajes y de horas extraordinarias.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="An4">
      <bpmn:text>DOLOR: obtencion de firmas del representante legal y firma de liquidaciones. OPORTUNIDAD: firma electronica avanzada.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As3" associationDirection="None" sourceRef="RevMarcaje" targetRef="An3" />
    <bpmn:association id="As1" associationDirection="None" sourceRef="PublicarOferta" targetRef="An1" />
    <bpmn:association id="As4" associationDirection="None" sourceRef="FirmasFiniq" targetRef="An4" />
  </bpmn:collaboration>
