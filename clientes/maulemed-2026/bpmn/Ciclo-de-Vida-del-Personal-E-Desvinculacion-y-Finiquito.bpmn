<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PER_v5_E" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_PER_E">
    <participant id="P_E" name="Desvinculación y finiquito — MauleMed" processRef="Process_PER_E" />
    <participant id="P_TRAB" name="Trabajador" />
    <participant id="P_INST" name="Notaría, Dirección del Trabajo y seguro de cesantía" />
    <messageFlow id="m01" name="Carta de aviso" sourceRef="NotificarTrab" targetRef="P_TRAB" />
    <messageFlow id="m02" name="Finiquito a ratificar" sourceRef="Ratificar" targetRef="P_INST" />
  </collaboration>
  <process id="Process_PER_E" isExecutable="false">
    <laneSet id="LaneSet_PER_E">
      <lane id="Lane_Med" name="Dirección médica — Dr. Retamal y Dr. Valenzuela">
        <flowNodeRef>StartTermino</flowNodeRef>
      </lane>
      <lane id="Lane_Pat" name="Patricia Lobos — Encargada de Personas y RR.HH.">
        <flowNodeRef>Causal</flowNodeRef>
        <flowNodeRef>Carta</flowNodeRef>
        <flowNodeRef>NotificarTrab</flowNodeRef>
        <flowNodeRef>CalcFiniquito</flowNodeRef>
        <flowNodeRef>RevRUT</flowNodeRef>
        <flowNodeRef>GwFiniquito</flowNodeRef>
        <flowNodeRef>CorregirFiniquito</flowNodeRef>
        <flowNodeRef>FirmasFiniq</flowNodeRef>
        <flowNodeRef>Ratificar</flowNodeRef>
        <flowNodeRef>Bustos</flowNodeRef>
        <flowNodeRef>PagoFiniq</flowNodeRef>
        <flowNodeRef>CierreDeFontana</flowNodeRef>
        <flowNodeRef>Archivar</flowNodeRef>
        <flowNodeRef>EndTermino</flowNodeRef>
      </lane>
      <lane id="Lane_Liz" name="Liz Bravo — Jefa de Administración y Finanzas">
        <flowNodeRef>ValidarAFC</flowNodeRef>
        <flowNodeRef>EmitirCheque</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartTermino" name="Se decide el término de la relación laboral">
      <outgoing>f01</outgoing>
    </startEvent>
    <userTask id="Causal" name="Determinar la causal y los hechos que la fundan">
      <incoming>f01</incoming>
      <outgoing>f02</outgoing>
    </userTask>
    <userTask id="Carta" name="Redactar la carta de aviso">
      <incoming>f02</incoming>
      <outgoing>f03</outgoing>
      <dataOutputAssociation id="DataOut_Carta">
        <targetRef>Data_Carta</targetRef>
      </dataOutputAssociation>
    </userTask>
    <sendTask id="NotificarTrab" name="Notificar al trabajador dentro del plazo legal">
      <incoming>f03</incoming>
      <outgoing>f04</outgoing>
    </sendTask>
    <userTask id="CalcFiniquito" name="Calcular el finiquito según la causal">
      <incoming>f04</incoming>
      <outgoing>f05</outgoing>
      <dataOutputAssociation id="DataOut_Finiquito">
        <targetRef>Data_Finiquito</targetRef>
      </dataOutputAssociation>
    </userTask>
    <manualTask id="RevRUT" name="Revisar RUT, nombres y montos del finiquito">
      <incoming>f05</incoming>
      <incoming>f08</incoming>
      <outgoing>f06</outgoing>
    </manualTask>
    <exclusiveGateway id="GwFiniquito" name="¿El finiquito está correcto?">
      <incoming>f06</incoming>
      <outgoing>f07</outgoing>
      <outgoing>f09</outgoing>
    </exclusiveGateway>
    <userTask id="CorregirFiniquito" name="Corregir el finiquito y rehacer el documento">
      <incoming>f07</incoming>
      <outgoing>f08</outgoing>
    </userTask>
    <userTask id="ValidarAFC" name="Validar el seguro de cesantía, descuentos y demás haberes">
      <incoming>f09</incoming>
      <outgoing>f10</outgoing>
    </userTask>
    <userTask id="EmitirCheque" name="Emitir el cheque del finiquito">
      <incoming>f10</incoming>
      <outgoing>f11</outgoing>
    </userTask>
    <userTask id="FirmasFiniq" name="Recabar las firmas del representante legal y del trabajador">
      <incoming>f11</incoming>
      <outgoing>f12</outgoing>
    </userTask>
    <userTask id="Ratificar" name="Ratificar el finiquito ante ministro de fe">
      <incoming>f12</incoming>
      <outgoing>f13</outgoing>
    </userTask>
    <userTask id="Bustos" name="Acreditar el pago de las cotizaciones previsionales">
      <incoming>f13</incoming>
      <outgoing>f14</outgoing>
    </userTask>
    <userTask id="PagoFiniq" name="Pagar el finiquito y entregar los comprobantes">
      <incoming>f14</incoming>
      <outgoing>f15</outgoing>
    </userTask>
    <userTask id="CierreDeFontana" name="Cerrar e inactivar al trabajador en DeFontana">
      <incoming>f15</incoming>
      <outgoing>f16</outgoing>
    </userTask>
    <userTask id="Archivar" name="Archivar el expediente y enviar copia a la Dirección del Trabajo">
      <incoming>f16</incoming>
      <outgoing>f17</outgoing>
    </userTask>
    <endEvent id="EndTermino" name="Relación laboral finalizada">
      <incoming>f17</incoming>
    </endEvent>
    <dataObjectReference id="Data_Carta" name="Carta de aviso de término" dataObjectRef="DataObject_Carta" />
    <dataObject id="DataObject_Carta" />
    <dataObjectReference id="Data_Finiquito" name="Finiquito calculado" dataObjectRef="DataObject_Finiquito" />
    <dataObject id="DataObject_Finiquito" />
    <sequenceFlow id="f01" sourceRef="StartTermino" targetRef="Causal" />
    <sequenceFlow id="f02" sourceRef="Causal" targetRef="Carta" />
    <sequenceFlow id="f03" sourceRef="Carta" targetRef="NotificarTrab" />
    <sequenceFlow id="f04" sourceRef="NotificarTrab" targetRef="CalcFiniquito" />
    <sequenceFlow id="f05" sourceRef="CalcFiniquito" targetRef="RevRUT" />
    <sequenceFlow id="f06" sourceRef="RevRUT" targetRef="GwFiniquito" />
    <sequenceFlow id="f07" name="NO" sourceRef="GwFiniquito" targetRef="CorregirFiniquito" />
    <sequenceFlow id="f08" sourceRef="CorregirFiniquito" targetRef="RevRUT" />
    <sequenceFlow id="f09" name="SÍ" sourceRef="GwFiniquito" targetRef="ValidarAFC" />
    <sequenceFlow id="f10" sourceRef="ValidarAFC" targetRef="EmitirCheque" />
    <sequenceFlow id="f11" sourceRef="EmitirCheque" targetRef="FirmasFiniq" />
    <sequenceFlow id="f12" sourceRef="FirmasFiniq" targetRef="Ratificar" />
    <sequenceFlow id="f13" sourceRef="Ratificar" targetRef="Bustos" />
    <sequenceFlow id="f14" sourceRef="Bustos" targetRef="PagoFiniq" />
    <sequenceFlow id="f15" sourceRef="PagoFiniq" targetRef="CierreDeFontana" />
    <sequenceFlow id="f16" sourceRef="CierreDeFontana" targetRef="Archivar" />
    <sequenceFlow id="f17" sourceRef="Archivar" targetRef="EndTermino" />
  </process>
