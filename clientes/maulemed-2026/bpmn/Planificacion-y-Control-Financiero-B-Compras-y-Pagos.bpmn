<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PCF_v5_B" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_PCF_B">
    <participant id="P_B" name="Compras y pago a proveedores — MauleMed" processRef="Process_PCF_B" />
    <participant id="P_PROV" name="Proveedores" />
    <participant id="P_BANCO" name="Banco" />
    <messageFlow id="m01" name="Orden de compra o pedido" sourceRef="EnviarPedido" targetRef="P_PROV" />
    <messageFlow id="m02" name="Insumos" sourceRef="P_PROV" targetRef="RecepInsumos" />
    <messageFlow id="m03" name="Factura del proveedor" sourceRef="P_PROV" targetRef="RecepFactura" />
    <messageFlow id="m04" name="Cartola bancaria" sourceRef="P_BANCO" targetRef="RecepCartola" />
  </collaboration>
  <process id="Process_PCF_B" isExecutable="false">
    <laneSet id="LaneSet_PCF_B">
      <lane id="Lane_Sol" name="Sucursales (solicitantes)">
        <flowNodeRef>StartCompra</flowNodeRef>
        <flowNodeRef>EnviarSolicitud</flowNodeRef>
      </lane>
      <lane id="Lane_Liz" name="Liz Bravo — Jefa de Administración y Finanzas">
        <flowNodeRef>GwRecurrente</flowNodeRef>
        <flowNodeRef>DecidirSinPpto</flowNodeRef>
        <flowNodeRef>MergeCompra</flowNodeRef>
        <flowNodeRef>VistoBuenoSol</flowNodeRef>
        <flowNodeRef>GwVB</flowNodeRef>
        <flowNodeRef>EndRechazada</flowNodeRef>
        <flowNodeRef>FechaPago</flowNodeRef>
        <flowNodeRef>RevisarPagos</flowNodeRef>
        <flowNodeRef>EndPagado</flowNodeRef>
      </lane>
      <lane id="Lane_Gab" name="Gabriela Morales — Compras y Tesorería">
        <flowNodeRef>RevisarSolicitud</flowNodeRef>
        <flowNodeRef>GwOC</flowNodeRef>
        <flowNodeRef>OrdenCompra</flowNodeRef>
        <flowNodeRef>MergeOC</flowNodeRef>
        <flowNodeRef>EnviarPedido</flowNodeRef>
        <flowNodeRef>GwQuiebre</flowNodeRef>
        <flowNodeRef>CubrirQuiebre</flowNodeRef>
        <flowNodeRef>EndQuiebre</flowNodeRef>
        <flowNodeRef>RecepInsumos</flowNodeRef>
        <flowNodeRef>VerificarRecepcion</flowNodeRef>
        <flowNodeRef>DespacharInsumos</flowNodeRef>
        <flowNodeRef>RecepFactura</flowNodeRef>
        <flowNodeRef>VistoBuenoFactura</flowNodeRef>
        <flowNodeRef>GwConforme</flowNodeRef>
        <flowNodeRef>RequerirFaltantes</flowNodeRef>
        <flowNodeRef>MergeConforme</flowNodeRef>
        <flowNodeRef>EmitirCheque</flowNodeRef>
        <flowNodeRef>RecepCartola</flowNodeRef>
      </lane>
      <lane id="Lane_Con" name="Contabilidad — Elvira Rojas y Meribet Escobar">
        <flowNodeRef>RegistrarFactura</flowNodeRef>
        <flowNodeRef>AprobarPago</flowNodeRef>
        <flowNodeRef>ConciliarBanco</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartCompra" name="Surge la necesidad de un insumo o servicio">
      <outgoing>f01</outgoing>
    </startEvent>
    <sendTask id="EnviarSolicitud" name="Enviar la solicitud de compra a tesorería">
      <incoming>f01</incoming>
      <outgoing>f02</outgoing>
    </sendTask>
    <userTask id="RevisarSolicitud" name="Revisar la solicitud de compra">
      <incoming>f02</incoming>
      <outgoing>f03</outgoing>
    </userTask>
    <exclusiveGateway id="GwRecurrente" name="¿Es una compra recurrente planificada?">
      <incoming>f03</incoming>
      <outgoing>f04</outgoing>
      <outgoing>f05</outgoing>
    </exclusiveGateway>
    <manualTask id="DecidirSinPpto" name="Decidir la compra sin evaluación presupuestaria">
      <incoming>f05</incoming>
      <outgoing>f06</outgoing>
    </manualTask>
    <exclusiveGateway id="MergeCompra" name="Solicitud lista para el visto bueno">
      <incoming>f04</incoming>
      <incoming>f06</incoming>
      <outgoing>f07</outgoing>
    </exclusiveGateway>
    <userTask id="VistoBuenoSol" name="Dar el visto bueno a la solicitud">
      <incoming>f07</incoming>
      <outgoing>f08</outgoing>
    </userTask>
    <exclusiveGateway id="GwVB" name="¿La Jefatura da el visto bueno?">
      <incoming>f08</incoming>
      <outgoing>f09</outgoing>
      <outgoing>f10</outgoing>
    </exclusiveGateway>
    <endEvent id="EndRechazada" name="Solicitud de compra rechazada">
      <incoming>f09</incoming>
    </endEvent>
    <exclusiveGateway id="GwOC" name="¿El proveedor trabaja con orden de compra?">
      <incoming>f10</incoming>
      <outgoing>f11</outgoing>
      <outgoing>f13</outgoing>
    </exclusiveGateway>
    <userTask id="OrdenCompra" name="Emitir la orden de compra">
      <incoming>f11</incoming>
      <outgoing>f12</outgoing>
      <dataOutputAssociation id="DataOut_OC">
        <targetRef>Data_OC</targetRef>
      </dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="MergeOC" name="Pedido listo para enviar">
      <incoming>f12</incoming>
      <incoming>f13</incoming>
      <outgoing>fw14</outgoing>
    </exclusiveGateway>
    <sendTask id="EnviarPedido" name="Enviar el pedido al proveedor por correo electrónico">
      <incoming>fw14</incoming>
      <outgoing>f15</outgoing>
    </sendTask>
    <exclusiveGateway id="GwQuiebre" name="¿Hay quiebre de stock mientras llega el pedido?">
      <incoming>f15</incoming>
      <outgoing>f16</outgoing>
      <outgoing>f18</outgoing>
    </exclusiveGateway>
    <subProcess id="CubrirQuiebre" name="Cubrir el quiebre de stock">
      <incoming>f16</incoming>
      <outgoing>f17</outgoing>
    </subProcess>
    <endEvent id="EndQuiebre" name="Quiebre de stock cubierto">
      <incoming>f17</incoming>
    </endEvent>
    <intermediateCatchEvent id="RecepInsumos" name="Recepción de los insumos en la central">
      <incoming>f18</incoming>
      <outgoing>f19</outgoing>
      <messageEventDefinition id="MessageEventDefinition_RecepInsumos" />
    </intermediateCatchEvent>
    <manualTask id="VerificarRecepcion" name="Verificar que llegue todo lo solicitado">
      <incoming>f19</incoming>
      <outgoing>f20</outgoing>
    </manualTask>
    <userTask id="DespacharInsumos" name="Despachar los insumos a las sucursales">
      <incoming>f20</incoming>
      <outgoing>f21</outgoing>
    </userTask>
    <intermediateCatchEvent id="RecepFactura" name="Recepción de la factura del proveedor">
      <incoming>f21</incoming>
      <outgoing>f22</outgoing>
      <messageEventDefinition id="MessageEventDefinition_RecepFactura" />
    </intermediateCatchEvent>
    <userTask id="VistoBuenoFactura" name="Dar el visto bueno a la factura">
      <incoming>f22</incoming>
      <outgoing>f23</outgoing>
    </userTask>
    <exclusiveGateway id="GwConforme" name="¿La recepción y la factura están conformes?">
      <incoming>f23</incoming>
      <outgoing>f24</outgoing>
      <outgoing>f26</outgoing>
    </exclusiveGateway>
    <sendTask id="RequerirFaltantes" name="Requerir los faltantes o solicitar la nota de crédito">
      <incoming>f24</incoming>
      <outgoing>f25</outgoing>
    </sendTask>
    <exclusiveGateway id="MergeConforme" name="Recepción y factura conformes">
      <incoming>f25</incoming>
      <incoming>f26</incoming>
      <outgoing>f27</outgoing>
    </exclusiveGateway>
    <userTask id="RegistrarFactura" name="Registrar la factura en contabilidad">
      <incoming>f27</incoming>
      <outgoing>f28</outgoing>
    </userTask>
    <userTask id="AprobarPago" name="Aprobar el pago junto con tesorería">
      <incoming>f28</incoming>
      <outgoing>f29</outgoing>
    </userTask>
    <userTask id="FechaPago" name="Determinar y aprobar la fecha de pago">
      <incoming>f29</incoming>
      <outgoing>f30</outgoing>
    </userTask>
    <userTask id="EmitirCheque" name="Emitir el cheque al proveedor">
      <incoming>f30</incoming>
      <outgoing>f31</outgoing>
    </userTask>
    <intermediateCatchEvent id="RecepCartola" name="Recepción de la cartola bancaria">
      <incoming>f31</incoming>
      <outgoing>f32</outgoing>
      <messageEventDefinition id="MessageEventDefinition_RecepCartola" />
    </intermediateCatchEvent>
    <userTask id="ConciliarBanco" name="Registrar el pago y realizar la conciliación bancaria">
      <incoming>f32</incoming>
      <outgoing>f33</outgoing>
    </userTask>
    <userTask id="RevisarPagos" name="Revisar los pagos de todas las empresas">
      <incoming>f33</incoming>
      <outgoing>f34</outgoing>
    </userTask>
    <endEvent id="EndPagado" name="Pago realizado y conciliado">
      <incoming>f34</incoming>
    </endEvent>
    <dataObjectReference id="Data_OC" name="Orden de compra" dataObjectRef="DataObject_OC" />
    <dataObject id="DataObject_OC" />
    <sequenceFlow id="f01" sourceRef="StartCompra" targetRef="EnviarSolicitud" />
    <sequenceFlow id="f02" sourceRef="EnviarSolicitud" targetRef="RevisarSolicitud" />
    <sequenceFlow id="f03" sourceRef="RevisarSolicitud" targetRef="GwRecurrente" />
    <sequenceFlow id="f04" name="SÍ" sourceRef="GwRecurrente" targetRef="MergeCompra" />
    <sequenceFlow id="f05" name="NO" sourceRef="GwRecurrente" targetRef="DecidirSinPpto" />
    <sequenceFlow id="f06" sourceRef="DecidirSinPpto" targetRef="MergeCompra" />
    <sequenceFlow id="f07" sourceRef="MergeCompra" targetRef="VistoBuenoSol" />
    <sequenceFlow id="f08" sourceRef="VistoBuenoSol" targetRef="GwVB" />
    <sequenceFlow id="f09" name="NO" sourceRef="GwVB" targetRef="EndRechazada" />
    <sequenceFlow id="f10" name="SÍ" sourceRef="GwVB" targetRef="GwOC" />
    <sequenceFlow id="f11" name="SÍ" sourceRef="GwOC" targetRef="OrdenCompra" />
    <sequenceFlow id="f12" sourceRef="OrdenCompra" targetRef="MergeOC" />
    <sequenceFlow id="f13" name="NO" sourceRef="GwOC" targetRef="MergeOC" />
    <sequenceFlow id="fw14" sourceRef="MergeOC" targetRef="EnviarPedido" />
    <sequenceFlow id="f15" sourceRef="EnviarPedido" targetRef="GwQuiebre" />
    <sequenceFlow id="f16" name="SÍ" sourceRef="GwQuiebre" targetRef="CubrirQuiebre" />
    <sequenceFlow id="f17" sourceRef="CubrirQuiebre" targetRef="EndQuiebre" />
    <sequenceFlow id="f18" name="NO" sourceRef="GwQuiebre" targetRef="RecepInsumos" />
    <sequenceFlow id="f19" sourceRef="RecepInsumos" targetRef="VerificarRecepcion" />
    <sequenceFlow id="f20" sourceRef="VerificarRecepcion" targetRef="DespacharInsumos" />
    <sequenceFlow id="f21" sourceRef="DespacharInsumos" targetRef="RecepFactura" />
    <sequenceFlow id="f22" sourceRef="RecepFactura" targetRef="VistoBuenoFactura" />
    <sequenceFlow id="f23" sourceRef="VistoBuenoFactura" targetRef="GwConforme" />
    <sequenceFlow id="f24" name="NO" sourceRef="GwConforme" targetRef="RequerirFaltantes" />
    <sequenceFlow id="f25" sourceRef="RequerirFaltantes" targetRef="MergeConforme" />
    <sequenceFlow id="f26" name="SÍ" sourceRef="GwConforme" targetRef="MergeConforme" />
    <sequenceFlow id="f27" sourceRef="MergeConforme" targetRef="RegistrarFactura" />
    <sequenceFlow id="f28" sourceRef="RegistrarFactura" targetRef="AprobarPago" />
    <sequenceFlow id="f29" sourceRef="AprobarPago" targetRef="FechaPago" />
    <sequenceFlow id="f30" sourceRef="FechaPago" targetRef="EmitirCheque" />
    <sequenceFlow id="f31" sourceRef="EmitirCheque" targetRef="RecepCartola" />
    <sequenceFlow id="f32" sourceRef="RecepCartola" targetRef="ConciliarBanco" />
    <sequenceFlow id="f33" sourceRef="ConciliarBanco" targetRef="RevisarPagos" />
    <sequenceFlow id="f34" sourceRef="RevisarPagos" targetRef="EndPagado" />
  </process>
