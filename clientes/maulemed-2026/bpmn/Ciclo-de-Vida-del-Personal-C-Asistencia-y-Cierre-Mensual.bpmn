<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PER_v5_C" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_PER_C">
    <participant id="P_C" name="Control de asistencia y cierre mensual — MauleMed" processRef="Process_PER_C" />
    <participant id="P_TRAB" name="Trabajadores" />
    <messageFlow id="m01" name="Liquidación de sueldo" sourceRef="FirmarLiq" targetRef="P_TRAB" />
  </collaboration>
  <process id="Process_PER_C" isExecutable="false">
    <laneSet id="LaneSet_PER_C">
      <lane id="Lane_Pat" name="Patricia Lobos — Encargada de Personas y RR.HH.">
        <flowNodeRef>StartCierre</flowNodeRef>
        <flowNodeRef>RevMarcaje</flowNodeRef>
        <flowNodeRef>GwMarcaje</flowNodeRef>
        <flowNodeRef>CorregirMarcaje</flowNodeRef>
        <flowNodeRef>MergeMarcaje</flowNodeRef>
        <flowNodeRef>VerifPermLic</flowNodeRef>
        <flowNodeRef>RecargoDomFest</flowNodeRef>
        <flowNodeRef>CalcHHEE</flowNodeRef>
        <flowNodeRef>Viaticos</flowNodeRef>
        <flowNodeRef>ArchHHEE</flowNodeRef>
        <flowNodeRef>EnviarHHEE</flowNodeRef>
      </lane>
      <lane id="Lane_Liz" name="Liz Bravo — Jefa de Administración y Finanzas">
        <flowNodeRef>IngresarRem</flowNodeRef>
        <flowNodeRef>EmitirLiq</flowNodeRef>
        <flowNodeRef>FirmarLiq</flowNodeRef>
        <flowNodeRef>EndCierre</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartCierre" name="Día 24 o 25 de cada mes (cierre de asistencia)">
      <outgoing>f01</outgoing>
      <timerEventDefinition id="TimerEventDefinition_StartCierre" />
    </startEvent>
    <manualTask id="RevMarcaje" name="Revisar marcaje por marcaje, empresa por empresa">
      <incoming>f01</incoming>
      <outgoing>f02</outgoing>
      <dataOutputAssociation id="DataOut_Marcajes">
        <targetRef>Data_Marcajes</targetRef>
      </dataOutputAssociation>
    </manualTask>
    <exclusiveGateway id="GwMarcaje" name="¿El marcaje está correcto?">
      <incoming>f02</incoming>
      <outgoing>f03</outgoing>
      <outgoing>f04</outgoing>
    </exclusiveGateway>
    <userTask id="CorregirMarcaje" name="Corregir y respaldar los marcajes erróneos">
      <incoming>f03</incoming>
      <outgoing>f05</outgoing>
    </userTask>
    <exclusiveGateway id="MergeMarcaje" name="Marcaje conforme">
      <incoming>f04</incoming>
      <incoming>f05</incoming>
      <outgoing>f06</outgoing>
    </exclusiveGateway>
    <userTask id="VerifPermLic" name="Verificar que permisos y licencias estén ingresados">
      <incoming>f06</incoming>
      <outgoing>f07</outgoing>
    </userTask>
    <manualTask id="RecargoDomFest" name="Aplicar el recargo por trabajo en domingo y festivo">
      <incoming>f07</incoming>
      <outgoing>f08</outgoing>
    </manualTask>
    <manualTask id="CalcHHEE" name="Calcular las horas extraordinarias y sus recargos">
      <incoming>f08</incoming>
      <outgoing>fw09</outgoing>
    </manualTask>
    <userTask id="Viaticos" name="Incluir los viáticos y la movilización">
      <incoming>fw09</incoming>
      <outgoing>f10</outgoing>
    </userTask>
    <userTask id="ArchHHEE" name="Preparar el archivo mensual de horas extraordinarias">
      <incoming>f10</incoming>
      <outgoing>f11</outgoing>
    </userTask>
    <sendTask id="EnviarHHEE" name="Enviar el archivo a Remuneraciones">
      <incoming>f11</incoming>
      <outgoing>f12</outgoing>
    </sendTask>
    <userTask id="IngresarRem" name="Ingresar las horas extraordinarias a remuneraciones">
      <incoming>f12</incoming>
      <outgoing>f13</outgoing>
    </userTask>
    <userTask id="EmitirLiq" name="Emitir las liquidaciones de sueldo">
      <incoming>f13</incoming>
      <outgoing>f14</outgoing>
    </userTask>
    <userTask id="FirmarLiq" name="Recabar la firma de las liquidaciones">
      <incoming>f14</incoming>
      <outgoing>f15</outgoing>
    </userTask>
    <endEvent id="EndCierre" name="Asistencia y horas del mes cerradas">
      <incoming>f15</incoming>
    </endEvent>
    <dataObjectReference id="Data_Marcajes" name="Marcajes del mes · reloj control" dataObjectRef="DataObject_Marcajes" />
    <dataObject id="DataObject_Marcajes" />
    <sequenceFlow id="f01" sourceRef="StartCierre" targetRef="RevMarcaje" />
    <sequenceFlow id="f02" sourceRef="RevMarcaje" targetRef="GwMarcaje" />
    <sequenceFlow id="f03" name="NO" sourceRef="GwMarcaje" targetRef="CorregirMarcaje" />
    <sequenceFlow id="f04" name="SÍ" sourceRef="GwMarcaje" targetRef="MergeMarcaje" />
    <sequenceFlow id="f05" sourceRef="CorregirMarcaje" targetRef="MergeMarcaje" />
    <sequenceFlow id="f06" sourceRef="MergeMarcaje" targetRef="VerifPermLic" />
    <sequenceFlow id="f07" sourceRef="VerifPermLic" targetRef="RecargoDomFest" />
    <sequenceFlow id="f08" sourceRef="RecargoDomFest" targetRef="CalcHHEE" />
    <sequenceFlow id="fw09" sourceRef="CalcHHEE" targetRef="Viaticos" />
    <sequenceFlow id="f10" sourceRef="Viaticos" targetRef="ArchHHEE" />
    <sequenceFlow id="f11" sourceRef="ArchHHEE" targetRef="EnviarHHEE" />
    <sequenceFlow id="f12" sourceRef="EnviarHHEE" targetRef="IngresarRem" />
    <sequenceFlow id="f13" sourceRef="IngresarRem" targetRef="EmitirLiq" />
    <sequenceFlow id="f14" sourceRef="EmitirLiq" targetRef="FirmarLiq" />
    <sequenceFlow id="f15" sourceRef="FirmarLiq" targetRef="EndCierre" />
  </process>
