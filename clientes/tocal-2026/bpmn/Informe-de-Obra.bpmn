<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IO_0" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_IO_0">
    <participant id="P_IO" name="Informe de Obra semanal — Constructora Tocal" processRef="Process_IO_0" />
    <participant id="P_MAND" name="Mandante y especialistas" />
    <messageFlow id="m01" name="Respuestas a RDI" sourceRef="P_MAND" targetRef="SubB" />
  </collaboration>
  <process id="Process_IO_0" isExecutable="false">
    <laneSet id="LaneSet_IO_0">
      <lane id="Lane_Prev" name="Prevencionista">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>SubA</flowNodeRef>
      </lane>
      <lane id="Lane_Adm" name="Administrador de Obra">
        <flowNodeRef>SubB</flowNodeRef>
      </lane>
      <lane id="Lane_Ger" name="Gerente de Proyectos">
        <flowNodeRef>SubC</flowNodeRef>
        <flowNodeRef>GwVisita</flowNodeRef>
        <flowNodeRef>SubD</flowNodeRef>
        <flowNodeRef>EndVisita</flowNodeRef>
        <flowNodeRef>EndSinVisita</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Cada semana de obra">
      <outgoing>f01</outgoing>
      <timerEventDefinition id="TimerEventDefinition_Start" />
    </startEvent>
    <subProcess id="SubA" name="IO-A · Evaluación de prevención">
      <incoming>f01</incoming>
      <outgoing>f02</outgoing>
    </subProcess>
    <subProcess id="SubB" name="IO-B · Elaboración del informe">
      <incoming>f02</incoming>
      <outgoing>f03</outgoing>
    </subProcess>
    <subProcess id="SubC" name="IO-C · Revisión y reunión de gerencia">
      <incoming>f03</incoming>
      <outgoing>f04</outgoing>
    </subProcess>
    <exclusiveGateway id="GwVisita" name="¿Quedan temas por verificar en terreno?">
      <incoming>f04</incoming>
      <outgoing>f05</outgoing>
      <outgoing>f07</outgoing>
    </exclusiveGateway>
    <subProcess id="SubD" name="IO-D · Visita a terreno y seguimiento">
      <incoming>f05</incoming>
      <outgoing>f06</outgoing>
    </subProcess>
    <endEvent id="EndVisita" name="Tareas de la visita cerradas">
      <incoming>f06</incoming>
    </endEvent>
    <endEvent id="EndSinVisita" name="Estado de las obras revisado">
      <incoming>f07</incoming>
    </endEvent>
    <sequenceFlow id="f01" sourceRef="Start" targetRef="SubA" />
    <sequenceFlow id="f02" sourceRef="SubA" targetRef="SubB" />
    <sequenceFlow id="f03" sourceRef="SubB" targetRef="SubC" />
    <sequenceFlow id="f04" sourceRef="SubC" targetRef="GwVisita" />
    <sequenceFlow id="f05" name="Sí" sourceRef="GwVisita" targetRef="SubD" />
    <sequenceFlow id="f06" sourceRef="SubD" targetRef="EndVisita" />
    <sequenceFlow id="f07" name="No" sourceRef="GwVisita" targetRef="EndSinVisita" />
  </process>
