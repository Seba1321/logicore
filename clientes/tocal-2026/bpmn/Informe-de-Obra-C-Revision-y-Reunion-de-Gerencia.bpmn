<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IO_C" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_IO_C">
    <participant id="P_C" name="IO-C · Revisión de informes y reunión de gerencia — Tocal" processRef="Process_IO_C" />
  </collaboration>
  <process id="Process_IO_C" isExecutable="false">
    <laneSet id="LaneSet_IO_C">
      <lane id="Lane_Ger" name="Gerente de Proyectos">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>Fotos</flowNodeRef>
        <flowNodeRef>Avance</flowNodeRef>
        <flowNodeRef>GwDudas</flowNodeRef>
        <flowNodeRef>Contrastar</flowNodeRef>
        <flowNodeRef>GwDudasJoin</flowNodeRef>
        <flowNodeRef>Lunes</flowNodeRef>
        <flowNodeRef>LnkBandaCOut</flowNodeRef>
        <flowNodeRef>LnkBandaCIn</flowNodeRef>
        <flowNodeRef>Presentar</flowNodeRef>
        <flowNodeRef>GwAtraso</flowNodeRef>
        <flowNodeRef>Explicar</flowNodeRef>
        <flowNodeRef>GwAtrasoJoin</flowNodeRef>
        <flowNodeRef>Anotar</flowNodeRef>
        <flowNodeRef>End</flowNodeRef>
      </lane>
      <lane id="Lane_JPR" name="Jefe de Prevención">
        <flowNodeRef>Exponer</flowNodeRef>
      </lane>
      <lane id="Lane_Com" name="Reunión de gerencia">
        <flowNodeRef>Comparar</flowNodeRef>
        <flowNodeRef>GwBajo</flowNodeRef>
        <flowNodeRef>Alerta</flowNodeRef>
        <flowNodeRef>GwBajoJoin</flowNodeRef>
        <flowNodeRef>Cuestionar</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Informes de obra recibidos (viernes o fin de semana)">
      <outgoing>f01</outgoing>
    </startEvent>
    <userTask id="Fotos" name="Revisar fotos de la semana">
      <incoming>f01</incoming>
      <outgoing>f02</outgoing>
    </userTask>
    <userTask id="Avance" name="Revisar avance, ruta crítica y problemas">
      <incoming>f02</incoming>
      <outgoing>f03</outgoing>
    </userTask>
    <exclusiveGateway id="GwDudas" name="¿Hay dudas sobre lo informado?">
      <incoming>f03</incoming>
      <outgoing>f04</outgoing>
      <outgoing>f06</outgoing>
    </exclusiveGateway>
    <userTask id="Contrastar" name="Contrastar con MS Project">
      <incoming>f04</incoming>
      <outgoing>f05</outgoing>
    </userTask>
    <exclusiveGateway id="GwDudasJoin">
      <incoming>f05</incoming>
      <incoming>f06</incoming>
      <outgoing>f07</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="Lunes" name="Lunes: reunión de gerencia">
      <incoming>f07</incoming>
      <outgoing>f08</outgoing>
      <timerEventDefinition id="TimerEventDefinition_Lunes" />
    </intermediateCatchEvent>
    <intermediateThrowEvent id="LnkBandaCOut" name="A">
      <incoming>f08</incoming>
      <linkEventDefinition id="LinkEventDefinition_LnkBandaCOut" name="A" />
    </intermediateThrowEvent>
    <intermediateCatchEvent id="LnkBandaCIn" name="A">
      <outgoing>f09</outgoing>
      <linkEventDefinition id="LinkEventDefinition_LnkBandaCIn" name="A" />
    </intermediateCatchEvent>
    <manualTask id="Exponer" name="Exponer novedades de prevención">
      <incoming>f09</incoming>
      <outgoing>f10</outgoing>
    </manualTask>
    <manualTask id="Comparar" name="Comparar prevención entre obras">
      <incoming>f10</incoming>
      <outgoing>f11</outgoing>
    </manualTask>
    <exclusiveGateway id="GwBajo" name="¿Alguna obra bajo el estándar?">
      <incoming>f11</incoming>
      <outgoing>f12</outgoing>
      <outgoing>f14</outgoing>
    </exclusiveGateway>
    <manualTask id="Alerta" name="Levantar alerta de la obra">
      <incoming>f12</incoming>
      <outgoing>f13</outgoing>
    </manualTask>
    <exclusiveGateway id="GwBajoJoin">
      <incoming>f13</incoming>
      <incoming>f14</incoming>
      <outgoing>f15</outgoing>
    </exclusiveGateway>
    <manualTask id="Presentar" name="Presentar avance y fotos de cada obra">
      <incoming>f15</incoming>
      <outgoing>f16</outgoing>
    </manualTask>
    <exclusiveGateway id="GwAtraso" name="¿La obra va atrasada?">
      <incoming>f16</incoming>
      <outgoing>f17</outgoing>
      <outgoing>f19</outgoing>
    </exclusiveGateway>
    <manualTask id="Explicar" name="Explicar la causa de palabra">
      <incoming>f17</incoming>
      <outgoing>f18</outgoing>
    </manualTask>
    <exclusiveGateway id="GwAtrasoJoin">
      <incoming>f18</incoming>
      <incoming>f19</incoming>
      <outgoing>f20</outgoing>
    </exclusiveGateway>
    <manualTask id="Cuestionar" name="Cuestionar fotos, atrasos y problemas">
      <incoming>f20</incoming>
      <outgoing>f21</outgoing>
    </manualTask>
    <manualTask id="Anotar" name="Anotar temas a revisar en terreno">
      <incoming>f21</incoming>
      <outgoing>f22</outgoing>
    </manualTask>
    <endEvent id="End" name="Obras revisadas; acuerdos sin registro">
      <incoming>f22</incoming>
    </endEvent>
    <sequenceFlow id="f01" sourceRef="Start" targetRef="Fotos" />
    <sequenceFlow id="f02" sourceRef="Fotos" targetRef="Avance" />
    <sequenceFlow id="f03" sourceRef="Avance" targetRef="GwDudas" />
    <sequenceFlow id="f04" name="Sí" sourceRef="GwDudas" targetRef="Contrastar" />
    <sequenceFlow id="f05" sourceRef="Contrastar" targetRef="GwDudasJoin" />
    <sequenceFlow id="f06" name="No" sourceRef="GwDudas" targetRef="GwDudasJoin" />
    <sequenceFlow id="f07" sourceRef="GwDudasJoin" targetRef="Lunes" />
    <sequenceFlow id="f08" sourceRef="Lunes" targetRef="LnkBandaCOut" />
    <sequenceFlow id="f09" sourceRef="LnkBandaCIn" targetRef="Exponer" />
    <sequenceFlow id="f10" sourceRef="Exponer" targetRef="Comparar" />
    <sequenceFlow id="f11" sourceRef="Comparar" targetRef="GwBajo" />
    <sequenceFlow id="f12" name="Sí" sourceRef="GwBajo" targetRef="Alerta" />
    <sequenceFlow id="f13" sourceRef="Alerta" targetRef="GwBajoJoin" />
    <sequenceFlow id="f14" name="No" sourceRef="GwBajo" targetRef="GwBajoJoin" />
    <sequenceFlow id="f15" sourceRef="GwBajoJoin" targetRef="Presentar" />
    <sequenceFlow id="f16" sourceRef="Presentar" targetRef="GwAtraso" />
    <sequenceFlow id="f17" name="Sí" sourceRef="GwAtraso" targetRef="Explicar" />
    <sequenceFlow id="f18" sourceRef="Explicar" targetRef="GwAtrasoJoin" />
    <sequenceFlow id="f19" name="No" sourceRef="GwAtraso" targetRef="GwAtrasoJoin" />
    <sequenceFlow id="f20" sourceRef="GwAtrasoJoin" targetRef="Cuestionar" />
    <sequenceFlow id="f21" sourceRef="Cuestionar" targetRef="Anotar" />
    <sequenceFlow id="f22" sourceRef="Anotar" targetRef="End" />
  </process>
