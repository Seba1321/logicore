<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IO_A" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_IO_A">
    <participant id="P_A" name="IO-A · Evaluación de prevención de la obra (PDR) — Tocal" processRef="Process_IO_A" />
  </collaboration>
  <process id="Process_IO_A" isExecutable="false">
    <laneSet id="LaneSet_IO_A">
      <lane id="Lane_Prev" name="Prevencionista de Obra">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>Estadistica</flowNodeRef>
        <flowNodeRef>Recorrer</flowNodeRef>
        <flowNodeRef>Chequeo</flowNodeRef>
        <flowNodeRef>Cumplimiento</flowNodeRef>
        <flowNodeRef>GwAcc</flowNodeRef>
        <flowNodeRef>DetalleAcc</flowNodeRef>
        <flowNodeRef>GwJoin</flowNodeRef>
        <flowNodeRef>Enviar</flowNodeRef>
      </lane>
      <lane id="Lane_Adm" name="Administrador de Obra">
        <flowNodeRef>End</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Semana de obra cerrada">
      <outgoing>f01</outgoing>
    </startEvent>
    <userTask id="Estadistica" name="Registrar dotación, HH e incidentes">
      <incoming>f01</incoming>
      <outgoing>f02</outgoing>
      <dataOutputAssociation id="DataOut_Estad">
        <targetRef>Data_Estad</targetRef>
      </dataOutputAssociation>
    </userTask>
    <manualTask id="Recorrer" name="Recorrer la obra">
      <incoming>f02</incoming>
      <outgoing>f03</outgoing>
    </manualTask>
    <userTask id="Chequeo" name="Responder la lista de chequeo">
      <incoming>f03</incoming>
      <outgoing>f04</outgoing>
      <dataOutputAssociation id="DataOut_Lista">
        <targetRef>Data_Lista</targetRef>
      </dataOutputAssociation>
    </userTask>
    <userTask id="Cumplimiento" name="Calcular % de cumplimiento">
      <incoming>f04</incoming>
      <outgoing>f05</outgoing>
    </userTask>
    <exclusiveGateway id="GwAcc" name="¿Hubo accidente en la semana?">
      <incoming>f05</incoming>
      <outgoing>f06</outgoing>
      <outgoing>f08</outgoing>
    </exclusiveGateway>
    <userTask id="DetalleAcc" name="Registrar accidente y días perdidos">
      <incoming>f06</incoming>
      <outgoing>f07</outgoing>
    </userTask>
    <exclusiveGateway id="GwJoin">
      <incoming>f07</incoming>
      <incoming>f08</incoming>
      <outgoing>f09</outgoing>
    </exclusiveGateway>
    <userTask id="Enviar" name="Enviar evaluación PDR (jueves)">
      <incoming>f09</incoming>
      <outgoing>f10</outgoing>
    </userTask>
    <endEvent id="End" name="Evaluación PDR entregada al administrador">
      <incoming>f10</incoming>
    </endEvent>
    <dataObjectReference id="Data_Estad" name="Estadísticas PDR · Excel" dataObjectRef="DataObject_Estad" />
    <dataObject id="DataObject_Estad" />
    <dataObjectReference id="Data_Lista" name="Lista de chequeo PDR · Excel (estándar Copec)" dataObjectRef="DataObject_Lista" />
    <dataObject id="DataObject_Lista" />
    <sequenceFlow id="f01" sourceRef="Start" targetRef="Estadistica" />
    <sequenceFlow id="f02" sourceRef="Estadistica" targetRef="Recorrer" />
    <sequenceFlow id="f03" sourceRef="Recorrer" targetRef="Chequeo" />
    <sequenceFlow id="f04" sourceRef="Chequeo" targetRef="Cumplimiento" />
    <sequenceFlow id="f05" sourceRef="Cumplimiento" targetRef="GwAcc" />
    <sequenceFlow id="f06" name="Sí" sourceRef="GwAcc" targetRef="DetalleAcc" />
    <sequenceFlow id="f07" sourceRef="DetalleAcc" targetRef="GwJoin" />
    <sequenceFlow id="f08" name="No" sourceRef="GwAcc" targetRef="GwJoin" />
    <sequenceFlow id="f09" sourceRef="GwJoin" targetRef="Enviar" />
    <sequenceFlow id="f10" sourceRef="Enviar" targetRef="End" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_IO_A">
      <bpmndi:BPMNShape id="P_A_di" bpmnElement="P_A" isHorizontal="true">
        <omgdc:Bounds x="160" y="160" width="1690" height="390" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Prev_di" bpmnElement="Lane_Prev" isHorizontal="true">
