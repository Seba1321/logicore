          <omgdc:Bounds x="414" y="386" width="132" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Lista_di" bpmnElement="Data_Lista">
