<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IO_B" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_IO_B">
    <participant id="P_B" name="IO-B · Elaboración y envío del informe de obra — Tocal" processRef="Process_IO_B" />
    <participant id="P_MAND" name="Mandante y especialistas" />
    <messageFlow id="m01" name="Solicitud de cambio" sourceRef="Solicitar" targetRef="P_MAND" />
    <messageFlow id="m02" name="Respuestas a RDI" sourceRef="P_MAND" targetRef="RDI" />
  </collaboration>
  <process id="Process_IO_B" isExecutable="false">
    <laneSet id="LaneSet_IO_B">
      <lane id="Lane_Adm" name="Administrador de Obra (u Oficina Técnica por delegación)">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>PDR</flowNodeRef>
        <flowNodeRef>Project</flowNodeRef>
        <flowNodeRef>GwCambio</flowNodeRef>
        <flowNodeRef>Solicitar</flowNodeRef>
        <flowNodeRef>GwCambioJoin</flowNodeRef>
        <flowNodeRef>Curvas</flowNodeRef>
        <flowNodeRef>LnkBandaBOut</flowNodeRef>
        <flowNodeRef>LnkBandaBIn</flowNodeRef>
        <flowNodeRef>Comentarios</flowNodeRef>
        <flowNodeRef>EDP</flowNodeRef>
        <flowNodeRef>RDI</flowNodeRef>
        <flowNodeRef>Fotos</flowNodeRef>
        <flowNodeRef>GwOT</flowNodeRef>
        <flowNodeRef>Filtrar</flowNodeRef>
        <flowNodeRef>GwJoin</flowNodeRef>
        <flowNodeRef>PDF</flowNodeRef>
      </lane>
      <lane id="Lane_Ger" name="Gerente de Proyectos">
        <flowNodeRef>End</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Evaluación PDR recibida (jueves)">
      <outgoing>f01</outgoing>
    </startEvent>
    <userTask id="PDR" name="Pegar PDR (punto 1)">
      <incoming>f01</incoming>
      <outgoing>f02</outgoing>
    </userTask>
    <userTask id="Project" name="Ingresar avance en MS Project">
      <incoming>f02</incoming>
      <outgoing>f03</outgoing>
      <dataOutputAssociation id="DataOut_Project">
        <targetRef>Data_Project</targetRef>
      </dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="GwCambio" name="¿El avance exige cambiar el programa?">
      <incoming>f03</incoming>
      <outgoing>f04</outgoing>
      <outgoing>f06</outgoing>
    </exclusiveGateway>
    <sendTask id="Solicitar" name="Solicitar validación al mandante">
      <incoming>f04</incoming>
      <outgoing>f05</outgoing>
    </sendTask>
    <exclusiveGateway id="GwCambioJoin">
      <incoming>f05</incoming>
      <incoming>f06</incoming>
      <outgoing>f07</outgoing>
    </exclusiveGateway>
    <userTask id="Curvas" name="Traspasar % y actualizar curvas S (punto 2)">
      <incoming>f07</incoming>
      <outgoing>f08</outgoing>
      <dataOutputAssociation id="DataOut_Curvas">
        <targetRef>Data_Curvas</targetRef>
      </dataOutputAssociation>
    </userTask>
    <intermediateThrowEvent id="LnkBandaBOut" name="A">
      <incoming>f08</incoming>
      <linkEventDefinition id="LinkEventDefinition_LnkBandaBOut" name="A" />
    </intermediateThrowEvent>
    <intermediateCatchEvent id="LnkBandaBIn" name="A">
      <outgoing>f09</outgoing>
      <linkEventDefinition id="LinkEventDefinition_LnkBandaBIn" name="A" />
    </intermediateCatchEvent>
    <userTask id="Comentarios" name="Redactar comentarios y problemas">
      <incoming>f09</incoming>
      <outgoing>f10</outgoing>
    </userTask>
    <userTask id="EDP" name="Actualizar EDP (punto 3)">
      <incoming>f10</incoming>
      <outgoing>f11</outgoing>
    </userTask>
    <userTask id="RDI" name="Actualizar resumen de RDI (punto 4)">
      <incoming>f11</incoming>
      <outgoing>f12</outgoing>
    </userTask>
    <userTask id="Fotos" name="Descargar y pegar fotos (punto 5)">
      <incoming>f12</incoming>
      <outgoing>f13</outgoing>
    </userTask>
    <exclusiveGateway id="GwOT" name="¿Lo preparó la oficina técnica?">
      <incoming>f13</incoming>
      <outgoing>f14</outgoing>
      <outgoing>f16</outgoing>
    </exclusiveGateway>
    <userTask id="Filtrar" name="Revisar borrador de oficina técnica">
      <incoming>f14</incoming>
      <outgoing>f15</outgoing>
    </userTask>
    <exclusiveGateway id="GwJoin">
      <incoming>f15</incoming>
      <incoming>f16</incoming>
      <outgoing>f17</outgoing>
    </exclusiveGateway>
    <userTask id="PDF" name="Exportar a PDF y enviar (viernes)">
      <incoming>f17</incoming>
      <outgoing>f18</outgoing>
      <dataOutputAssociation id="DataOut_PDF">
        <targetRef>Data_PDF</targetRef>
      </dataOutputAssociation>
    </userTask>
    <endEvent id="End" name="Informe de obra entregado al gerente de proyectos">
      <incoming>f18</incoming>
    </endEvent>
    <dataObjectReference id="Data_Project" name="Programa de obra · MS Project" dataObjectRef="DataObject_Project" />
    <dataObject id="DataObject_Project" />
    <dataObjectReference id="Data_Curvas" name="Planilla curvas S, EDP y RDI · Excel" dataObjectRef="DataObject_Curvas" />
    <dataObject id="DataObject_Curvas" />
    <dataObjectReference id="Data_PDF" name="Informe de obra · PDF" dataObjectRef="DataObject_PDF" />
    <dataObject id="DataObject_PDF" />
    <sequenceFlow id="f01" sourceRef="Start" targetRef="PDR" />
    <sequenceFlow id="f02" sourceRef="PDR" targetRef="Project" />
    <sequenceFlow id="f03" sourceRef="Project" targetRef="GwCambio" />
    <sequenceFlow id="f04" name="Sí" sourceRef="GwCambio" targetRef="Solicitar" />
    <sequenceFlow id="f05" sourceRef="Solicitar" targetRef="GwCambioJoin" />
    <sequenceFlow id="f06" name="No" sourceRef="GwCambio" targetRef="GwCambioJoin" />
    <sequenceFlow id="f07" sourceRef="GwCambioJoin" targetRef="Curvas" />
    <sequenceFlow id="f08" sourceRef="Curvas" targetRef="LnkBandaBOut" />
    <sequenceFlow id="f09" sourceRef="LnkBandaBIn" targetRef="Comentarios" />
    <sequenceFlow id="f10" sourceRef="Comentarios" targetRef="EDP" />
    <sequenceFlow id="f11" sourceRef="EDP" targetRef="RDI" />
    <sequenceFlow id="f12" sourceRef="RDI" targetRef="Fotos" />
    <sequenceFlow id="f13" sourceRef="Fotos" targetRef="GwOT" />
    <sequenceFlow id="f14" name="Sí" sourceRef="GwOT" targetRef="Filtrar" />
    <sequenceFlow id="f15" sourceRef="Filtrar" targetRef="GwJoin" />
    <sequenceFlow id="f16" name="No" sourceRef="GwOT" targetRef="GwJoin" />
    <sequenceFlow id="f17" sourceRef="GwJoin" targetRef="PDF" />
    <sequenceFlow id="f18" sourceRef="PDF" targetRef="End" />
  </process>
