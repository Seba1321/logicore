<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IO_D" targetNamespace="http://bpmn.io/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_IO_D">
    <participant id="P_D" name="IO-D · Visita a terreno y seguimiento de tareas — Tocal" processRef="Process_IO_D" />
  </collaboration>
  <process id="Process_IO_D" isExecutable="false">
    <laneSet id="LaneSet_IO_D">
      <lane id="Lane_Ger" name="Gerente de Proyectos">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>Recorrer</flowNodeRef>
        <flowNodeRef>Acordar</flowNodeRef>
        <flowNodeRef>Resumir</flowNodeRef>
        <flowNodeRef>Recibir</flowNodeRef>
        <flowNodeRef>GwTodas</flowNodeRef>
        <flowNodeRef>EndOk</flowNodeRef>
        <flowNodeRef>Proxima</flowNodeRef>
      </lane>
      <lane id="Lane_Adm" name="Administrador de Obra">
        <flowNodeRef>Explicar</flowNodeRef>
        <flowNodeRef>Ejecutar</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Visita a la obra iniciada">
      <outgoing>f01</outgoing>
    </startEvent>
    <manualTask id="Recorrer" name="Recorrer la obra con el administrador">
      <incoming>f01</incoming>
      <incoming>f10</incoming>
      <outgoing>f02</outgoing>
    </manualTask>
    <manualTask id="Explicar" name="Explicar el estado de cada partida">
      <incoming>f02</incoming>
      <outgoing>f03</outgoing>
    </manualTask>
    <manualTask id="Acordar" name="Acordar tareas de palabra">
      <incoming>f03</incoming>
      <outgoing>f04</outgoing>
    </manualTask>
    <manualTask id="Resumir" name="Resumir pendientes, sin registro escrito">
      <incoming>f04</incoming>
      <outgoing>f05</outgoing>
    </manualTask>
    <userTask id="Ejecutar" name="Resolver tareas y responder por correo">
      <incoming>f05</incoming>
      <outgoing>f06</outgoing>
    </userTask>
    <userTask id="Recibir" name="Revisar respuestas por correo">
      <incoming>f06</incoming>
      <outgoing>f07</outgoing>
    </userTask>
    <exclusiveGateway id="GwTodas" name="¿Se confirman cerradas todas las tareas?">
      <incoming>f07</incoming>
      <outgoing>f08</outgoing>
      <outgoing>f09</outgoing>
    </exclusiveGateway>
    <endEvent id="EndOk" name="Tareas de la visita cerradas">
      <incoming>f08</incoming>
    </endEvent>
    <intermediateCatchEvent id="Proxima" name="Próxima visita a la obra">
      <incoming>f09</incoming>
      <outgoing>f10</outgoing>
      <timerEventDefinition id="TimerEventDefinition_Proxima" />
    </intermediateCatchEvent>
    <sequenceFlow id="f01" sourceRef="Start" targetRef="Recorrer" />
    <sequenceFlow id="f02" sourceRef="Recorrer" targetRef="Explicar" />
    <sequenceFlow id="f03" sourceRef="Explicar" targetRef="Acordar" />
    <sequenceFlow id="f04" sourceRef="Acordar" targetRef="Resumir" />
    <sequenceFlow id="f05" sourceRef="Resumir" targetRef="Ejecutar" />
    <sequenceFlow id="f06" sourceRef="Ejecutar" targetRef="Recibir" />
    <sequenceFlow id="f07" sourceRef="Recibir" targetRef="GwTodas" />
    <sequenceFlow id="f08" name="Sí" sourceRef="GwTodas" targetRef="EndOk" />
    <sequenceFlow id="f09" name="No" sourceRef="GwTodas" targetRef="Proxima" />
    <sequenceFlow id="f10" sourceRef="Proxima" targetRef="Recorrer" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_IO_D">
